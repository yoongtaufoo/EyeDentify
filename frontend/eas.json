{
    "cli": {
      "version": ">= 10.0.0"
    },
    "build": {
      "development": {
        "developmentClient": true,
        "distribution": "internal"
      },
      "preview": {
        "distribution": "internal",
        "android": {
          "buildType": "apk"
        },
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=4096"
        }
      },
      "production": {
        "android": {
          "buildType": "apk"
        },
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=4096"
        }
      }
    },
    "submit": {
      "production": {}
    }
  }